{
  "name": "kubernetes-contexts",
  "displayName": "Kubernetes Contexts",
  "description": "Podman Desktop extension allowing to manage Kubernetes contexts",
  "version": "0.3.0-next",
  "icon": "icon.png",
  "publisher": "podman-desktop",
  "license": "Apache-2.0",
  "engines": {
    "podman-desktop": ">=1.18.0"
  },
  "main": "./dist/main.js",
  "contributes": {
    "features": [
      "kubernetes-contexts-manager"
    ]
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run --coverage",
    "test:watch": "vitest watch --coverage",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\"",
    "lint:check": "eslint . --ext js,ts,tsx",
    "lint:fix": "eslint . --fix --ext js,ts,tsx",
    "watch": "vite --mode development build -w"
  },
  "devDependencies": {
    "@kubernetes-contexts/rpc": "workspace:*",
    "@kubernetes-contexts/channels": "workspace:*",
    "@podman-desktop/api": "1.29.1",
    "@podman-desktop/kubernetes-dashboard-extension-api": "0.5.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-import-resolver-custom-alias": "^1.3.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-etc": "^2.0.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-no-null": "^1.0.2",
    "eslint-plugin-redundant-undefined": "^1.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "memfs": "^4.68.1",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "vite": "^8.2",
    "vitest": "^4.1.0",
    "@types/ws": "^8.18.0"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "inversify": "^8.2.3",
    "js-yaml": "^5.2.3",
    "reflect-metadata": "^0.2.2"
  }
}
